# BharatStock API Key (Required for Indian market data - NSE/BSE)
# Format: bsk_live_...
BHARATSTOCK_API_KEY=your_rotated_key_here
BHARATSTOCK_BASE_URL=https://bharatstockapi.com

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Connection (Neon PostgreSQL or local PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/pickmystock?schema=public

# Optional AI Assistant Integration (leave empty or 'none' for deterministic-only mode)
# Supported: gemini, openai, anthropic, or none
AI_PROVIDER=none
AI_API_KEY=your_optional_ai_key_here
